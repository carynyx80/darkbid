PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/darkbid
CORS_ORIGIN=http://localhost:3000
# Optional claim relayer (leave unset to disable)
# RPC_URL=
# PRESALE_ADDRESS=
# RELAYER_PRIVATE_KEY=
# RELAYER_FEE_BPS=100
# Optional Solana claim relayer (leave unset to disable)
# SOLANA_RPC_URL=
# SOLANA_PROGRAM_ID=
# SOLANA_RELAYER_SECRET=[...]   JSON byte array of the relayer keypair
# SOLANA_RELAYER_FEE_BPS=100
# Project review: approve/reject with this bearer token (24+ characters). Leave unset to disable the endpoint.
# ADMIN_TOKEN=
# Set to true to list new projects without review.
# AUTO_APPROVE_PROJECTS=false
# Site address used for links in the launch feed (/projects/feed.xml).
# PUBLIC_SITE_URL=https://darkbid-xi.vercel.app
# Telegram review bot (see README). Token comes from @BotFather.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_USERNAME=yieldcore1
# TELEGRAM_CHAT_ID=
# PUBLIC_API_URL=   defaults to Railway's public domain
